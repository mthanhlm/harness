{
  "lenses": [
    {
      "name": "lens-frontend",
      "domain": "web frontend",
      "paths": [
        "**/*.tsx",
        "**/*.jsx",
        "**/*.css",
        "**/*.scss",
        "components/**"
      ]
    },
    {
      "name": "lens-backend",
      "domain": "API and services",
      "paths": [
        "api/**",
        "app/api/**",
        "routes/**",
        "server/**",
        "**/route.ts",
        "**/handlers/**",
        "**/*_api.py"
      ]
    },
    {
      "name": "lens-database",
      "domain": "schema and queries",
      "paths": [
        "db/**",
        "drizzle/**",
        "migrations/**",
        "**/*.sql",
        "**/schema.ts",
        "**/drizzle.config.ts"
      ]
    },
    {
      "name": "lens-python",
      "domain": "Python",
      "paths": [
        "**/*.py",
        "**/*.pyi",
        "pytest.ini",
        "conftest.py",
        "pyproject.toml"
      ]
    },
    {
      "name": "lens-typescript",
      "domain": "TypeScript",
      "paths": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        "**/*.cts",
        "tsconfig.json"
      ]
    },
    {
      "name": "lens-testing",
      "domain": "test design",
      "paths": [
        "**/tests/**",
        "**/__tests__/**",
        "**/test_*.py",
        "**/*_test.py",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "conftest.py"
      ]
    },
    {
      "name": "lens-security",
      "domain": "security",
      "paths": [
        "**/auth/**",
        "**/*auth*.ts",
        "**/*auth*.py",
        "**/middleware/**",
        "**/.env*"
      ]
    },
    {
      "name": "lens-llm-agents",
      "domain": "LLM and agent systems",
      "paths": [
        "**/prompts/**",
        "**/agents/**",
        "**/skills/**",
        "**/*SKILL.md",
        "**/evals/**",
        "**/*agent*.py",
        "**/*agent*.ts"
      ]
    },
    {
      "name": "lens-infra",
      "domain": "config, CI and shell",
      "paths": [
        "**/Dockerfile*",
        "**/docker-compose*.yml",
        ".github/**",
        "**/*.sh",
        "**/*.bash",
        "**/.env*",
        "**/*.tf",
        "Makefile"
      ]
    },
    {
      "name": "lens-requirements",
      "domain": "requirements and product thinking",
      "paths": [
        "**/*spec*.md",
        "**/*requirements*.md",
        "**/PRD*.md",
        "**/*rfc*.md",
        "**/*design*.md"
      ]
    },
    {
      "name": "lens-contracts",
      "domain": "API contracts, versioning and migration",
      "paths": [
        "**/migrations/**",
        "**/*.proto",
        "**/openapi*.yaml",
        "**/openapi*.json",
        "**/*.graphql",
        "**/*.d.ts",
        "CHANGELOG.md",
        "**/drizzle/**",
        "**/alembic/**"
      ]
    },
    {
      "name": "lens-evaluation",
      "domain": "evaluation and observability",
      "paths": [
        "**/evals/**",
        "**/*eval*.py",
        "**/*eval*.ts",
        "**/*bench*.py",
        "**/telemetry/**",
        "**/*metrics*",
        "**/*tracing*",
        "**/*otel*",
        "**/*logger*"
      ]
    }
  ],
  "roles": [
    {
      "name": "challenger",
      "phase": "before",
      "when": "Before a plan is drafted, on anything triage did not route to A. Answers what the user story really is, what in the code contradicts the request, what past decision it reverses, whether the capability already exists, and whether to build it at all.",
      "always": false
    },
    {
      "name": "designer",
      "phase": "before",
      "when": "Route C only, after the challenger. Run twice in one message under opposed framings \u2014 smallest change that works, and the structure this actually needs. Neither sees the other; where the two designs diverge is what the user decides.",
      "always": false
    },
    {
      "name": "reviewer-correctness",
      "phase": "after",
      "when": "Any change to behaviour.",
      "always": true
    },
    {
      "name": "reviewer-bloat",
      "phase": "after",
      "when": "Any change that adds code.",
      "always": true
    },
    {
      "name": "reviewer-tests",
      "phase": "after",
      "when": "Tests were written or changed, or behaviour changed without tests.",
      "always": false
    },
    {
      "name": "reviewer-security",
      "phase": "after",
      "when": "The change touches user input, authentication, authorisation, queries, file paths, external calls or configuration.",
      "always": false
    },
    {
      "name": "reviewer-perf",
      "phase": "after",
      "when": "The change loops over user data, queries a database, renders a list, or sits on a request path.",
      "always": false
    },
    {
      "name": "reviewer-coherence",
      "phase": "after",
      "when": "The change adds a mechanism, a migration, a config field, a generated or exported file, or a second home for something that already exists. Asks whether the finished change agrees with itself — a concept now owned twice, a guard keyed on a condition that cannot occur, a copy that will drift from its source, an optional argument whose failure mode points the wrong way. Never whether it should have been built; that was settled before the plan.",
      "always": false
    },
    {
      "name": "reviewer-docs",
      "phase": "after",
      "when": "A signature, name, default, setup step, command or public behaviour changed.",
      "always": false
    },
    {
      "name": "refuter",
      "phase": "verify",
      "when": "Every finding any reviewer produces, before it reaches the user.",
      "always": true
    }
  ]
}
