{
  "lenses": [
    {
      "name": "lens-frontend",
      "domain": "web frontend",
      "paths": [
        "**/*.tsx",
        "**/*.jsx",
        "**/*.css",
        "**/*.scss",
        "components/**"
      ]
    },
    {
      "name": "lens-backend",
      "domain": "API and services",
      "paths": [
        "api/**",
        "app/api/**",
        "routes/**",
        "server/**",
        "**/route.ts",
        "**/handlers/**",
        "**/*_api.py"
      ]
    },
    {
      "name": "lens-database",
      "domain": "schema and queries",
      "paths": [
        "db/**",
        "drizzle/**",
        "migrations/**",
        "**/*.sql",
        "**/schema.ts",
        "**/drizzle.config.ts"
      ]
    },
    {
      "name": "lens-python",
      "domain": "Python",
      "paths": [
        "**/*.py",
        "**/*.pyi",
        "pytest.ini",
        "conftest.py",
        "pyproject.toml"
      ]
    },
    {
      "name": "lens-typescript",
      "domain": "TypeScript",
      "paths": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        "**/*.cts",
        "tsconfig.json"
      ]
    },
    {
      "name": "lens-testing",
      "domain": "test design",
      "paths": [
        "**/tests/**",
        "**/__tests__/**",
        "**/test_*.py",
        "**/*_test.py",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "conftest.py"
      ]
    },
    {
      "name": "lens-security",
      "domain": "security",
      "paths": [
        "**/auth/**",
        "**/*auth*.ts",
        "**/*auth*.py",
        "**/middleware/**",
        "**/.env*"
      ]
    },
    {
      "name": "lens-llm-agents",
      "domain": "LLM and agent systems",
      "paths": [
        "**/prompts/**",
        "**/agents/**",
        "**/skills/**",
        "**/*SKILL.md",
        "**/evals/**",
        "**/*agent*.py",
        "**/*agent*.ts"
      ]
    },
    {
      "name": "lens-infra",
      "domain": "config, CI and shell",
      "paths": [
        "**/Dockerfile*",
        "**/docker-compose*.yml",
        ".github/**",
        "**/*.sh",
        "**/*.bash",
        "**/.env*",
        "**/*.tf",
        "Makefile"
      ]
    }
  ],
  "roles": [
    {
      "name": "architect",
      "phase": "before",
      "when": "The change lands in unfamiliar or messy code, keeps fighting the existing design, or the question is whether to build it at all.",
      "always": false
    },
    {
      "name": "reuse-auditor",
      "phase": "before",
      "when": "Any new function, component, endpoint, table or utility is about to be written.",
      "always": true
    },
    {
      "name": "plan-challenger",
      "phase": "before",
      "when": "A plan has been drafted and not yet approved, and it spans more than about three files. Skipped below that: ceremony on a small request is how a process gets bypassed.",
      "always": false
    },
    {
      "name": "reviewer-correctness",
      "phase": "after",
      "when": "Any change to behaviour.",
      "always": true
    },
    {
      "name": "reviewer-bloat",
      "phase": "after",
      "when": "Any change that adds code.",
      "always": true
    },
    {
      "name": "reviewer-tests",
      "phase": "after",
      "when": "Tests were written or changed, or behaviour changed without tests.",
      "always": false
    },
    {
      "name": "reviewer-security",
      "phase": "after",
      "when": "The change touches user input, authentication, authorisation, queries, file paths, external calls or configuration.",
      "always": false
    },
    {
      "name": "reviewer-perf",
      "phase": "after",
      "when": "The change loops over user data, queries a database, renders a list, or sits on a request path.",
      "always": false
    },
    {
      "name": "reviewer-docs",
      "phase": "after",
      "when": "A signature, name, default, setup step, command or public behaviour changed.",
      "always": false
    },
    {
      "name": "refuter",
      "phase": "verify",
      "when": "Every finding any reviewer produces, before it reaches the user.",
      "always": true
    }
  ]
}
